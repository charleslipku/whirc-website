---
import MarkdownPage from '../../layouts/MarkdownPage.astro';
import SectionCards from '../../components/SectionCards.astro';
import { url } from '../../utils';
---

<MarkdownPage slug="research">
  <section class="section section--gray">
    <div class="container">
      <SectionCards
        items={[
          {
            title: 'Affinity Research Teams',
            text: 'Faculty-led teams in maternal & reproductive health, gendered stress, cardiovascular health, and AI for women’s health.',
            href: url('/research/affinity-research-teams/'),
          },
          {
            title: 'Publications',
            text: 'Peer-reviewed publications from WHIRC-affiliated researchers.',
            href: url('/research/publications/'),
          },
          {
            title: 'Projects',
            text: 'The WHIRC Grand Challenges award and other funded research across the collaborative.',
            href: url('/research/projects/'),
          },
        ]}
      />
    </div>
  </section>
</MarkdownPage>
