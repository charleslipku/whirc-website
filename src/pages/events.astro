---
import Base from '../layouts/Base.astro';
import { url } from '../utils';
import { site } from '../site';
import { getAllEvents, isUpcoming, formatEventDate, googleCalendarUrl } from '../events';

const all = await getAllEvents();
const now = new Date();
const upcoming = all.filter((e) => isUpcoming(e, now));
const past = all.filter((e) => !isUpcoming(e, now)).reverse();
const subscribe = site.calendar?.subscribe?.trim();
const ical = site.calendar?.ical?.trim();
const calendarView = site.calendar?.view?.trim();
const pageUrl = new URL(url('/events/'), Astro.site).href;
---

<Base title="Events" description="WHIRC seminars, symposia, workshops, and community events.">
  <div class="page-hero">
    <div class="container"><h1>Events</h1></div>
  </div>

  <section class="section" id="upcoming">
    <div class="container">
      <h2 class="section-heading">Upcoming Events</h2>
      <div class="intro">
        <p>
          WHIRC hosts seminars, workshops, and symposia that bring together
          researchers, students, clinicians, and community partners working on
          women's health across the University of Maryland.
          Event announcements go out first to our mailing list —
          <a href={url('/contact/')}>contact us</a> to join.
        </p>
        {(subscribe || ical || calendarView) && (
          <p class="subscribe">
            {subscribe && <a class="btn btn--primary" href={subscribe} rel="noopener">Subscribe in Google Calendar</a>}
            {ical && <a class="ical-link" href={ical.replace(/^https?:/, 'webcal:')}>Apple / Outlook feed</a>}
            {calendarView && <a class="ical-link" href={calendarView} rel="noopener">View full calendar</a>}
          </p>
        )}
      </div>

      {upcoming.length === 0 ? (
        <p class="empty">No upcoming events are scheduled at the moment.</p>
      ) : (
        <ul class="event-list">
          {upcoming.map((e) => (
            <li class="card event" id={e.id}>
              <div class="event-date" aria-hidden="true">
                <span class="event-month">
                  {e.date.toLocaleDateString('en-US', { month: 'short', timeZone: e.allDay ? 'UTC' : 'America/New_York' })}
                </span>
                <span class="event-day">
                  {e.date.toLocaleDateString('en-US', { day: 'numeric', timeZone: e.allDay ? 'UTC' : 'America/New_York' })}
                </span>
              </div>
              <div class="event-body">
                <h3>{e.title}</h3>
                <p class="event-meta">
                  {formatEventDate(e)}
                  {e.location && <> · {e.location}</>}
                </p>
                {e.Content ? <div class="event-desc prose-sm"><e.Content /></div>
                  : e.description && <p class="event-desc">{e.description}</p>}
                <p class="event-actions">
                  {e.links.map((l) => (
                    <a class="btn btn--primary" href={l.url} rel="noopener">{l.label}</a>
                  ))}
                </p>
                <p class="event-calendar">
                  <span class="event-calendar-label">Add to calendar:</span>
                  <a href={googleCalendarUrl(e, `${pageUrl}#${e.id}`)} rel="noopener" target="_blank">Google</a>
                  <span aria-hidden="true">·</span>
                  <a href={url(`/events/${e.id}.ics`)} download>Apple / Outlook (.ics)</a>
                </p>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  {past.length > 0 && (
    <section class="section section--gray" id="past">
      <div class="container">
        <h2 class="section-heading">Past Events</h2>
        <ul class="past-list">
          {past.map((e) => (
            <li>
              <strong>{e.title}</strong> — {formatEventDate(e)}
              {e.location && <> · {e.location}</>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .intro {
    max-width: 720px;
    margin: 0 auto 2.25rem;
    text-align: center;
    color: var(--gray-700);
  }
  .intro a:not(.btn) {
    text-decoration: underline;
  }
  .subscribe {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }
  .ical-link {
    font-size: 0.95rem;
  }
  .empty {
    text-align: center;
    color: var(--gray-700);
  }
  .event-list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 820px;
  }
  .event {
    display: flex;
    gap: 1.25rem;
    padding: 1.4rem;
  }
  .event-date {
    flex-shrink: 0;
    width: 74px;
    height: 74px;
    background: var(--umd-red-dark);
    color: var(--white);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1.1;
  }
  .event-month {
    text-transform: uppercase;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--umd-gold);
  }
  .event-day {
    font-family: var(--font-serif);
    font-size: 1.9rem;
    font-weight: 600;
  }
  .event-body {
    min-width: 0;
  }
  .event-body h3 {
    margin-bottom: 0.2rem;
  }
  .event-meta {
    color: var(--gray-700);
    font-size: 0.95rem;
    margin: 0 0 0.6rem;
  }
  .event-desc {
    color: var(--gray-700);
    margin: 0 0 0.75rem;
  }
  .event-desc :global(p) {
    margin: 0 0 0.6rem;
  }
  .event-desc :global(a) {
    text-decoration: underline;
  }
  .event-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 0;
  }
  .event-actions:empty {
    display: none;
  }
  .event-calendar {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
    align-items: center;
    margin: 0.75rem 0 0;
    font-size: 0.92rem;
    color: var(--gray-700);
  }
  .event-calendar-label {
    font-weight: 600;
  }
  .event-calendar a {
    text-decoration: underline;
  }
  .past-list {
    max-width: 820px;
    margin: 0 auto;
    color: var(--gray-700);
  }
  .past-list li {
    margin-bottom: 0.5rem;
  }
  @media (max-width: 560px) {
    .event {
      flex-direction: column;
    }
  }
</style>
